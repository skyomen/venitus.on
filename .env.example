# Venitus.on — variáveis de ambiente
#
# Copie para `.env` e preencha com valores locais.
# NENHUM valor real entra neste arquivo. Blueprint, seção 13.
#
# Regra que o CI verifica: não existe variável NEXT_PUBLIC_ carregando chave de banco.
# O navegador nunca recebe credencial (blueprint §4).

# ---------------------------------------------------------------------------
# Supabase — lidas apenas no servidor
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
# Crítica: só o worker e rotas administrativas. Nunca em middleware, nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# sintetico | espelho | producao-leitura | producao  (blueprint §18)
MODO_DADOS=sintetico
AMBIENTE=local

# Segundo fator para PLATFORM_ADMIN e GESTOR (blueprint §4.4).
# Vazio segue o ambiente: obrigatório em produção, desligado fora dela.
# `sim` ou `nao` forçam nos dois sentidos.
MFA_OBRIGATORIA=

# ---------------------------------------------------------------------------
# Criptografia — chaves distintas por propósito, nunca reaproveitadas
# ---------------------------------------------------------------------------
# Protege as credenciais de integração de cada corretora em repouso (§13.2).
CHAVE_CRIPTOGRAFIA_CREDENCIAIS=

# ---------------------------------------------------------------------------
# Webhooks de entrada — assinatura verificada antes de qualquer processamento (§10.4)
# ---------------------------------------------------------------------------
WEBHOOK_SEGREDO_WHATSAPP=
WEBHOOK_SEGREDO_MIDIA=

# ---------------------------------------------------------------------------
# Worker — o tique que drena as réguas e o outbox (§11.3)
# ---------------------------------------------------------------------------
# A Vercel envia este valor em `Authorization: Bearer ...` nas rotas agendadas.
# Vazio nega tudo: erro de implantação não pode virar porta aberta.
CRON_SECRET=
