{
  "name": "venitus-on",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma comercial multi-corretora para corretores de seguros",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "dup": "jscpd",
    "portao": "npm run format:check && npm run lint && npm run typecheck && npm run marcadores && npm run test:cov && npm run test:db && npm run dup && npm run build",
    "db:up": "supabase start",
    "db:down": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "prepare": "lefthook install",
    "marcadores": "node scripts/verificar-marcadores.mjs",
    "test:db": "vitest run --config vitest.db.config.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "jscpd": "^5.0.16",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
